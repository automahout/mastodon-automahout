<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>42.0.0</version>
	</parent>

	<groupId>org.mastodon</groupId>
	<artifactId>mastodon-automahout</artifactId>
	<version>0.1.0-SNAPSHOT</version>

	<name>Mastodon Automahout</name>
	<description>Mastodon plugin for automated tracking.</description>
	<url>https://github.com/mastodon-sc/mastodon-automahout</url>
	<inceptionYear>2025</inceptionYear>
	<organization>
		<name>Mastodon Science</name>
		<url>http://github.com/mastodon-sc</url>
	</organization>
	<licenses>
		<license>
			<name>BSD-2-Clause</name>
			<url>https://opensource.org/licenses/BSD-2-Clause</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<properties>
		<package-name>org.mastodon</package-name>
		<license.licenseName>bsd_2</license.licenseName>
		<license.projectName>mastodon-automahout</license.projectName>
		<license.organizationName>Mastodon authors</license.organizationName>
		<license.copyrightOwners>Ko Sugawara</license.copyrightOwners>

		<mastodon.version>1.0.0-beta-35</mastodon.version>
		<mastodon.group>org.mastodon</mastodon.group>

		<releaseProfiles>sign,deploy-to-scijava</releaseProfiles>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- AWS SDK v2 BOM (manages bedrockruntime + transitive AWS versions) -->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>2.38.9</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Override vulnerable transitive deps with patched versions -->
			<dependency>
				<groupId>io.airlift</groupId>
				<artifactId>aircompressor</artifactId>
				<version>2.0.3</version>
			</dependency>
			<dependency>
				<groupId>io.minio</groupId>
				<artifactId>minio</artifactId>
				<version>8.6.0</version>
			</dependency>
			<dependency>
				<groupId>io.grpc</groupId>
				<artifactId>grpc-netty-shaded</artifactId>
				<version>1.75.0</version>
			</dependency>
			<dependency>
				<groupId>commons-beanutils</groupId>
				<artifactId>commons-beanutils</artifactId>
				<version>1.11.0</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>1.84</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<mailingLists>
		<mailingList>
			<name>ImageJ Forum</name>
			<archive>https://forum.image.sc/</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/mastodon-sc/mastodon-automahout</connection>
		<developerConnection>scm:git:git@github.com:mastodon-sc/mastodon-automahout</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/mastodon-sc/mastodon-automahout</url>
	</scm>
	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/mastodon-sc/mastodon-automahout/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/mastodon-sc/mastodon-automahout/actions</url>
	</ciManagement>

	<developers>
		<developer>
			<id>ksugar</id>
			<name>Ko Sugawara</name>
			<email>ko.sugawara@riken.jp</email>
			<roles>
				<role>lead</role>
				<role>developer</role>
			</roles>
		</developer>
	</developers>

	<contributors>
		<contributor>
			<name>none</name>
		</contributor>
	</contributors>

	<repositories>
		<repository>
			<id>central</id>
			<url>https://repo1.maven.org/maven2/</url>
		</repository>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/repositories/public/</url>
		</repository>
	</repositories>

	<dependencies>
		<!-- Mastodon Core -->
		<dependency>
			<groupId>${mastodon.group}</groupId>
			<artifactId>mastodon</artifactId>
			<version>${mastodon.version}</version>
		</dependency>
		<!--
		  Contour fitting. Measured on Fluo-N2DL-HeLa_01 against CTC silver truth (2350 detections):
		  the detections this pipeline trains on overlap the cell at IoU 0.56. They contain it whole
		  (recall 1.00) at 1.31x its radius, so 42% of what is taught as "cell" is not one, and between
		  two touching cells the margin reaches into the neck. An ellipse on the cell's own axes scores
		  0.92. Cells here are elongated 1.40x at the median, which a sphere cannot follow at all.
		-->
		<dependency>
			<groupId>${mastodon.group}</groupId>
			<artifactId>mastodon-ellipsoid-fitting</artifactId>
			<version>0.7.2</version>
		</dependency>

		<!-- ELEPHANT: Deep learning tracking -->
		<dependency>
			<groupId>org.elephant</groupId>
			<artifactId>elephant</artifactId>
			<version>0.8.0</version>
		</dependency>

		<!-- JSON parsing for ELEPHANT API responses -->
		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
			<version>20240303</version>
		</dependency>

		<!-- GEFF (Zarr-based graph exchange format) reader, for importing ground-truth lineage
		     graphs used by the GT evaluation harness. -->
		<dependency>
			<groupId>org.litt</groupId>
			<artifactId>geff</artifactId>
			<version>1.1.0</version>
		</dependency>

		<!-- Amazon Bedrock backend (Claude via AWS). Uses the lightweight URLConnection HTTP client
		     to avoid pulling Netty/Apache; credentials resolve via the SDK default provider chain. -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>bedrockruntime</artifactId>
			<exclusions>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>netty-nio-client</artifactId>
				</exclusion>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>apache-client</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>url-connection-client</artifactId>
		</dependency>

		<!-- Test dependencies -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej-legacy</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${mastodon.group}</groupId>
			<artifactId>mastodon</artifactId>
			<version>${mastodon.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- pom-scijava gives tests 512 MB; CellScaleTest's 2200 x 2000 synthetic frames ran out of it
					     once the suite reached 812 tests (2026-10-24). The other arguments are the parent's. -->
					<!-- automahout.prefs.root: tests read and write a preferences node of their own, never the user's (a test
						 picked up the micro-SAM server configured in the GUI instead of its own fake). -->
					<argLine>@{argLine} -Xms512m -Xmx2g -Dapple.awt.UIElement=true --add-opens=java.base/java.lang=ALL-UNNAMED -Dautomahout.prefs.root=automahout-tests</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>